# RUN: choco-opt %s | filecheck %s

def foo(a : int, b: str, c: [int], d: [str], e : bool, f: [bool]) -> int:
    pass

# CHECK:      builtin.module {
# CHECK-NEXT:   "choco_ast.program"() ({
# CHECK-NEXT:     "choco_ast.func_def"() <{"func_name" = "foo"}> ({
# CHECK-NEXT:       "choco_ast.typed_var"() <{"var_name" = "a"}> ({
# CHECK-NEXT:         "choco_ast.type_name"() <{"type_name" = "int"}> : () -> ()
# CHECK-NEXT:       }) : () -> ()
# CHECK-NEXT:       "choco_ast.typed_var"() <{"var_name" = "b"}> ({
# CHECK-NEXT:         "choco_ast.type_name"() <{"type_name" = "str"}> : () -> ()
# CHECK-NEXT:       }) : () -> ()
# CHECK-NEXT:       "choco_ast.typed_var"() <{"var_name" = "c"}> ({
# CHECK-NEXT:         "choco_ast.list_type"() ({
# CHECK-NEXT:           "choco_ast.type_name"() <{"type_name" = "int"}> : () -> ()
# CHECK-NEXT:         }) : () -> ()
# CHECK-NEXT:       }) : () -> ()
# CHECK-NEXT:       "choco_ast.typed_var"() <{"var_name" = "d"}> ({
# CHECK-NEXT:         "choco_ast.list_type"() ({
# CHECK-NEXT:           "choco_ast.type_name"() <{"type_name" = "str"}> : () -> ()
# CHECK-NEXT:         }) : () -> ()
# CHECK-NEXT:       }) : () -> ()
# CHECK-NEXT:       "choco_ast.typed_var"() <{"var_name" = "e"}> ({
# CHECK-NEXT:         "choco_ast.type_name"() <{"type_name" = "bool"}> : () -> ()
# CHECK-NEXT:       }) : () -> ()
# CHECK-NEXT:       "choco_ast.typed_var"() <{"var_name" = "f"}> ({
# CHECK-NEXT:         "choco_ast.list_type"() ({
# CHECK-NEXT:           "choco_ast.type_name"() <{"type_name" = "bool"}> : () -> ()
# CHECK-NEXT:         }) : () -> ()
# CHECK-NEXT:       }) : () -> ()
# CHECK-NEXT:     }, {
# CHECK-NEXT:       "choco_ast.type_name"() <{"type_name" = "int"}> : () -> ()
# CHECK-NEXT:     }, {
# CHECK-NEXT:       "choco_ast.pass"() : () -> ()
# CHECK-NEXT:     }) : () -> ()
# CHECK-NEXT:   }, {
# CHECK-NEXT:   ^0:
# CHECK-NEXT:   }) : () -> ()
# CHECK-NEXT: }

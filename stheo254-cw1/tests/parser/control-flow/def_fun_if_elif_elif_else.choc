# RUN: choco-opt %s | filecheck %s

def foo():
    if True:
        "then"
    elif 1:
        "than"
    elif 2:
        "other"
    else:
        "thon"

# CHECK:      builtin.module {
# CHECK-NEXT:   "choco_ast.program"() ({
# CHECK-NEXT:     "choco_ast.func_def"() <{"func_name" = "foo"}> ({
# CHECK-NEXT:     ^0:
# CHECK-NEXT:     }, {
# CHECK-NEXT:       "choco_ast.type_name"() <{"type_name" = "<None>"}> : () -> ()
# CHECK-NEXT:     }, {
# CHECK-NEXT:       "choco_ast.if"() ({
# CHECK-NEXT:         "choco_ast.literal"() <{"value" = #choco_ast.bool<True>}> : () -> ()
# CHECK-NEXT:       }, {
# CHECK-NEXT:         "choco_ast.literal"() <{"value" = "then"}> : () -> ()
# CHECK-NEXT:       }, {
# CHECK-NEXT:         "choco_ast.if"() ({
# CHECK-NEXT:           "choco_ast.literal"() <{"value" = 1 : i32}> : () -> ()
# CHECK-NEXT:         }, {
# CHECK-NEXT:           "choco_ast.literal"() <{"value" = "than"}> : () -> ()
# CHECK-NEXT:         }, {
# CHECK-NEXT:           "choco_ast.if"() ({
# CHECK-NEXT:             "choco_ast.literal"() <{"value" = 2 : i32}> : () -> ()
# CHECK-NEXT:           }, {
# CHECK-NEXT:             "choco_ast.literal"() <{"value" = "other"}> : () -> ()
# CHECK-NEXT:           }, {
# CHECK-NEXT:             "choco_ast.literal"() <{"value" = "thon"}> : () -> ()
# CHECK-NEXT:           }) : () -> ()
# CHECK-NEXT:         }) : () -> ()
# CHECK-NEXT:       }) : () -> ()
# CHECK-NEXT:     }) : () -> ()
# CHECK-NEXT:   }, {
# CHECK-NEXT:   ^1:
# CHECK-NEXT:   }) : () -> ()
# CHECK-NEXT: }
